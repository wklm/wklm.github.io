(coq.theory
 (name FormalBlog)
 (package crane_blog)
 ; Typeset (top-level ../Typeset/dune, a SIBLING theory — must NOT live under
 ; src/ or dune double-binds it as FormalBlog.Typeset) is added so DecryptApp.v
 ; can [Require Import Typeset.Metrics / Typeset.GlyphLayout] for the
 ; Verified-Reader canvas render; dune sequences Typeset before FormalBlog from
 ; this dependency.  Typeset pulls in no OpenSSL and is std::any-free, so
 ; crane_decrypt.check still passes.
 (theories Stdlib Crane ITree ExtLib Paco Typeset)
 (plugins rocq-crane.plugin))

; @proofs alias — compiles ALL .v source files in the theory, so every theorem
; (T1, T5, T6, T7, and the new Phase 1–4 theorems) is machine-checked in CI on
; every push.  Depending on the .v sources forces dune to compile each one to
; .vo via the coq.theory rules.  Run as [dune build @proofs] in CI.
(rule
 (alias proofs)
 (deps (glob_files *.v))
 (action (progn)))

(rule
 (with-stdout-to main.cpp
   (echo "\
#include <blog.h>

int main() {
    run();
    return 0;
}
")))

(rule
 (targets blog_generator.exe)
 (deps Logic.vo main.cpp blog_helpers.h)
 (action (bash "\
clang++ -std=c++2b -O0 -fbracket-depth=1024 -fno-unroll-loops \
  -I . -I ../FormalBlog ../FormalBlog/blog.cpp main.cpp \
  -lssl -lcrypto \
  -o blog_generator.exe")))

; ──────────────────────────────────────────────────────────────────────
; SMTP listener (Facet C).  SmtpServer.v is extracted by the FormalBlog
; coq.theory above to ../FormalBlog/smtp_listener.{h,cpp}; here we compile it
; natively with clang++ (mirroring blog_generator.exe), linking OpenSSL for
; crypto_helpers.h and pthread for completeness.  net_helpers.h / proc_helpers.h
; are header-only POSIX shims (no extra link flags).  The smtp_listener entry
; takes no argv (config is read from the environment), so the generated
; main.cpp simply calls run().
(rule
 (with-stdout-to smtp_main.cpp
   (echo "\
#include <smtp_listener.h>

int main() {
    run();
    return 0;
}
")))

(rule
 (targets smtp_server.exe)
 (deps
  (file SmtpServer.vo)
  (file crypto_helpers.h)
  (file net_helpers.h)
  (file proc_helpers.h)
  smtp_main.cpp)
 (action (bash "\
clang++ -std=c++2b -O0 -fbracket-depth=1024 -fno-unroll-loops \
  -I . -I ../FormalBlog ../FormalBlog/smtp_listener.cpp smtp_main.cpp \
  -lssl -lcrypto -lpthread \
  -o smtp_server.exe")))

; Facet A — browser WASM apps (crane_decrypt / crane_enroll).
;
; DecryptApp.v / EnrollApp.v each end with [Crane Extraction "crane_<x>" run],
; so building their .vo emits ../FormalBlog/crane_<x>.{h,cpp} (extraction is a
; build side-effect; the .cpp is NOT a dune-tracked target, exactly like the
; blog_generator / encrypt_post rules).  The actual .mjs/.wasm are produced by
; the Dockerfile `wasm` stage with em++ (emsdk is not in crane-blog:builder).
;
; What we CAN do here, fast, in the builder image: a native clang++ compile of
; the extracted C++ against the signature-identical, OpenSSL-free stub
; (browser_helpers.h falls back to browser_helpers_stub.h when __EMSCRIPTEN__ is
; undefined).  This catches std::any leaks and any C++ type error in the tight
; loop before the heavy WASM link.  -O0 mirrors the WASM build; -c -o /dev/null
; keeps it a pure type/compile check (the extracted unit has `run`, no `main`).

(rule
 (targets crane_decrypt.check)
 (deps
  (file DecryptApp.vo)
  (file browser_helpers.h)
  (file browser_helpers_stub.h)
  (file crypto_helpers.h))
 (action (bash "\
clang++ -std=c++2b -O0 -fbracket-depth=1024 -fsyntax-only \
  -DCRANE_BROWSER_BUILD \
  -I ../src -I ../FormalBlog ../FormalBlog/crane_decrypt.cpp \
  && touch crane_decrypt.check")))

(rule
 (targets crane_enroll.check)
 (deps
  (file EnrollApp.vo)
  (file browser_helpers.h)
  (file browser_helpers_stub.h)
  (file crypto_helpers.h))
 (action (bash "\
clang++ -std=c++2b -O0 -fbracket-depth=1024 -fsyntax-only \
  -DCRANE_BROWSER_BUILD \
  -I ../src -I ../FormalBlog ../FormalBlog/crane_enroll.cpp \
  && touch crane_enroll.check")))

; Convenience aggregate so `dune build src/wasm_checks` runs both.
(rule
 (alias wasm_checks)
 (deps crane_decrypt.check crane_enroll.check)
 (action (progn)))
