_build/
_site/
node_modules/
*.vo
*.vok
*.vos
*.glob
*.aux
.lia.cache
.claude/
firebase-debug.log

# Plaintext posts are never committed. They live under posts/ on the
# author's working tree, are encrypted by the pre-commit hook into
# posts-encrypted/*.eml, and only the ciphertext is tracked.
posts/
!posts/.gitkeep

# Local GPG scratch used by the round-trip test
.gnupg-test/

# Never commit exported keys or passphrases
*.asc
*.gpg
*.pgp
*.key
secret*
passphrase*
tools/encrypt_post

# Playwright e2e (Facet A WASM acceptance gate) — generated artifacts.
# The WASM bundles are extracted from the wasm image at stage time; the certs
# are self-signed per run; reports/results/scratch are transient.
tests/e2e/.certs/
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/.cache/

# Crane-extracted WASM browser runtime, staged into static/ from the wasm image
# (crane-blog:wasm-merged). Rebuilt by CI / stage-site.sh; never committed.

# encrypt_post / round-trip scratch (key material + plaintext fixtures).
keys/
