#!/usr/bin/env bash
# pre-commit hook -- encrypt any staged posts/*.md into
# posts-encrypted/<slug>.eml, stage the ciphertext, and unstage the
# plaintext. The plaintext never enters a commit.
#
# Crypto + MIME framing are pure ROCQ (CryptoSpec.v / MimeBuild.v), Crane-
# extracted to the tools/encrypt_post.exe binary in this repo's dune build tree.
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

# --- Source-loss & secret safeguards (plan R2/R7; post-mortem rocq-wasm-migration-status) ---
# R2: block destructive recursive-delete primitives from entering scripts/config that execute.
# Markdown/docs are intentionally NOT scanned (they may describe these patterns in prose).
guarded=()
while IFS= read -r f; do
    [[ -n "$f" ]] && guarded+=("$f")
done < <(
    git diff --cached --name-only --diff-filter=AM \
        -- '*.sh' '*.bash' '*.yml' '*.yaml' 'Dockerfile*' '.githooks/*' 'scripts/*' 'smtp/*' \
        2>/dev/null || true
)
if [[ ${#guarded[@]} -gt 0 ]]; then
    for f in "${guarded[@]}"; do
        add="$(git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -Ev '^\+\+\+|^\+[[:space:]]*#' || true)"
        if grep -Eq 'git[[:space:]]+rm[[:space:]]+[^|&;#]*-[a-zA-Z]*r' <<<"$add" \
           || grep -Eq '(^|[[:space:]])rm[[:space:]]+-[a-zA-Z]*r[a-zA-Z]*[[:space:]]+(\.|\.\.|/|~|\./|/\*|\.\*)([[:space:]]|$)' <<<"$add"; then
            echo "pre-commit: refusing $f -- it introduces a destructive recursive working-tree delete." >&2
            echo "  (The source-loss incident wiped the tree from the wrong directory; such primitives" >&2
            echo "   are banned in scripts. Use a guarded, asserted deploy worktree instead -- plan R3/R4.)" >&2
            exit 1
        fi
        if grep -Eq 'git[[:space:]]+reset[[:space:]]+--hard' <<<"$add"; then
            echo "pre-commit: WARNING -- $f adds a hard reset; it MUST be preceded by a CWD/.git guard (plan R4)." >&2
        fi
    done
fi

# R7: never commit private key material (the loose key incident).
keyscan=()
while IFS= read -r f; do
    [[ -n "$f" ]] && keyscan+=("$f")
done < <(git diff --cached --name-only --diff-filter=AM 2>/dev/null || true)
if [[ ${#keyscan[@]} -gt 0 ]]; then
    for f in "${keyscan[@]}"; do
        if git show ":$f" 2>/dev/null | grep -Eq '^-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----'; then
            echo "pre-commit: refusing $f -- it contains a PRIVATE KEY block; keys never belong in the repo." >&2
            exit 1
        fi
    done
fi

# R8: single-source contract guard (plan R8) -- fail the commit if a tracked
# non-.v file falls outside the FFI-shim/build-config/docs/test/data allowlist
# (a .js/.ml/.py creeping back would mean behavioral logic left ROCQ).
bash "$repo/scripts/check-single-source.sh" >/dev/null

# Safety net: refuse to commit anything under posts-encrypted/ that is
# not an .eml ciphertext (or the .gitkeep). Catches the case where a
# plaintext file is misplaced directly into posts-encrypted/ and would
# otherwise bypass the encrypt step entirely.
bad=()
while IFS= read -r line; do
    [[ -n "$line" ]] && bad+=("$line")
done < <(
    git diff --cached --name-only --diff-filter=AM -- 'posts-encrypted/*' \
        | grep -Ev '(^posts-encrypted/[^/]+\.eml$|^posts-encrypted/\.gitkeep$)' \
        || true
)
if [[ ${#bad[@]} -gt 0 ]]; then
    echo "pre-commit: refusing to commit non-ciphertext under posts-encrypted/:" >&2
    printf '  %s\n' "${bad[@]}" >&2
    echo "Move plaintext into posts/ (gitignored) and commit from there." >&2
    exit 1
fi

emls=()
while IFS= read -r line; do
    [[ -n "$line" ]] && emls+=("$line")
done < <(
    git diff --cached --name-only --diff-filter=AM -- 'posts-encrypted/*.eml' || true
)
if [[ ${#emls[@]} -gt 0 ]]; then
    for eml in "${emls[@]}"; do
        if ! git show ":$eml" | tr -d '\r' | grep -qx 'Subject: \.\.\.'; then
            echo "pre-commit: refusing $eml; outer Subject must be literal ..." >&2
            exit 1
        fi
        if ! git show ":$eml" | tr -d '\r' | grep -qi '^Content-Type: multipart/hpke+wrapped'; then
            echo "pre-commit: refusing $eml; expected HPKE multipart/hpke+wrapped envelope" >&2
            exit 1
        fi
        if ! git show ":$eml" | tr -d '\r' | grep -q 'Public-Keys: '; then
            echo "pre-commit: refusing $eml; missing Public-Keys header" >&2
            exit 1
        fi
        if git show ":$eml" | tr -d '\r' | grep -Eq '^(From|To|Date): '; then
            echo "pre-commit: refusing $eml; outer envelope exposes sender, recipient, or date metadata" >&2
            exit 1
        fi
    done
fi
staged=()
while IFS= read -r line; do
    [[ -n "$line" ]] && staged+=("$line")
done < <(
    git diff --cached --name-only --diff-filter=AMR -- 'posts/*.md' || true
)

if [[ ${#staged[@]} -eq 0 ]]; then
    exit 0
fi

if ! command -v dune >/dev/null 2>&1; then
    echo "pre-commit: dune not on PATH; did you 'eval \$(opam env)'?" >&2
    exit 1
fi

dune build tools/encrypt_post.exe
enc="./_build/default/tools/encrypt_post.exe"

for path in "${staged[@]}"; do
    if [[ ! -f "$path" ]]; then
        echo "pre-commit: staged file missing from working tree: $path" >&2
        exit 1
    fi
    "$enc" --stage "$path"
done
